DATABASE_URL="postgresql://sangathe_admin:sangathe_secret_pass@localhost:5432/sangathe_db?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# At least 32 random characters. Never reuse this value across environments.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Protects /api/cron/publish. Use a different long random value.
CRON_SECRET="replace-with-another-long-random-secret"

# Cloudflare R2 permanent media storage — required for uploads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sangathe-media"
# Public bucket URL or HTTPS custom media domain, without a trailing slash.
R2_PUBLIC_URL="https://media.example.com"

# Web push notifications — required to enable push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:news@sangathe.com"

# Search and analytics — optional until production accounts are connected
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Use only the Search Console verification token, not the full meta tag.
GOOGLE_SITE_VERIFICATION=""

# Public social profile links — optional
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""
NEXT_PUBLIC_X_URL=""

# Self-hosted scheduler — required only with `npm run scheduler`.
# Vercel Cron uses NEXT_PUBLIC_SITE_URL and CRON_SECRET instead.
APP_URL="http://localhost:3000"
SCHEDULER_INTERVAL_MS="60000"

# Database seed accounts — required only for `npx prisma db seed`.
# Remove these from production after the initial accounts are created.
SEED_ADMIN_PASSWORD="replace-with-a-strong-temporary-admin-password"
SEED_REPORTER_PASSWORD="replace-with-a-strong-temporary-reporter-password"
